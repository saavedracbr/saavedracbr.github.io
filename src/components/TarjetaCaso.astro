---
import type { Caso } from '../data/casos.ts';
import { ruta } from '../utils/rutas.ts';

interface Props {
  caso: Caso;
  /** Nivel del título según dónde vaya la tarjeta. */
  nivel?: 'h2' | 'h3';
  /** Línea sobre el título; por defecto, el contexto del caso. */
  antetitulo?: string;
}

const { caso, nivel = 'h3', antetitulo = caso.contexto } = Astro.props;
const Titulo = nivel;
---

<li
  class="group relative flex flex-col rounded-[var(--radius-card)] border border-[var(--borde)] bg-[var(--superficie)] p-5 transition-colors hover:border-[var(--acento)]"
>
  <p class="font-mono text-eyebrow uppercase text-[var(--texto-suave)]">{antetitulo}</p>
  <Titulo class="mt-2 text-lg font-semibold leading-snug">
    <a href={ruta(`/casos/${caso.slug}`)} class="no-underline after:absolute after:inset-0 group-hover:text-[var(--acento)]">
      {caso.titulo}
    </a>
  </Titulo>
  <p class="mt-2 flex-1 text-[var(--texto-suave)]">{caso.bajada}</p>
  <p class="mt-3 text-sm"><span class="font-medium">Útil para:</span> <span class="text-[var(--texto-suave)]">{caso.paraRol}</span></p>
  <p class="mt-4 text-sm">
    <span class="rounded bg-[var(--acento-suave)] px-2 py-1 text-[var(--acento)]">{caso.estado}</span>
  </p>
</li>
