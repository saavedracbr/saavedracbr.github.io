---
import Base from '../layouts/Base.astro';
import TarjetaCaso from '../components/TarjetaCaso.astro';
import CifrasErp from '../components/CifrasErp.astro';
import { persona, oferta, pilares, cifrasErp } from '../data/perfil.ts';
import { casos } from '../data/casos.ts';
import { procesos } from '../data/erp.ts';
import { resumenMatricula } from '../data/dashboard.ts';
import { ruta } from '../utils/rutas.ts';

// Portada: la oferta, el ERP (cifras y los cuatro procesos, cada uno con su
// caso), los datos (el caso restante y el dashboard) y los pilares. Las demos se
// suman aquí cuando tengan página propia.
const slugsErp = new Set(procesos.map((p) => p.caso.slug));
const casosDatos = casos.filter((c) => !slugsErp.has(c.slug));
---

<Base titulo={`${persona.nombreCorto} – ${persona.titulo}`} descripcion={oferta.frase}>
  <section class="mx-auto max-w-5xl px-4 pb-12 pt-14 sm:px-6 sm:pt-20">
    <p class="font-mono text-eyebrow uppercase text-[var(--acento)]">
      {persona.titulo} · {persona.universidad}
    </p>
    <h1 class="mt-4 max-w-3xl text-hero font-semibold">{oferta.frase}</h1>
    <p class="mt-6 max-w-2xl text-lg text-[var(--texto-suave)]">{oferta.busqueda}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href={ruta('/cv-bruno-saavedra.pdf')}
        class="rounded-[var(--radius-card)] bg-[var(--acento)] px-5 py-3 font-medium text-white no-underline hover:opacity-90 dark:text-[var(--color-ink-950)]"
        >Descargar CV (PDF)</a
      >
      <a
        href={`mailto:${persona.email}`}
        class="rounded-[var(--radius-card)] border border-[var(--borde)] bg-[var(--superficie)] px-5 py-3 font-medium no-underline hover:border-[var(--acento)]"
        >Escríbeme</a
      >
      <a
        href={persona.linkedin}
        class="rounded-[var(--radius-card)] border border-[var(--borde)] bg-[var(--superficie)] px-5 py-3 font-medium no-underline hover:border-[var(--acento)]"
        rel="me">LinkedIn</a
      >
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 pb-14 sm:px-6" aria-labelledby="erp">
    <div class="flex flex-wrap items-baseline justify-between gap-2">
      <h2 id="erp" class="text-2xl font-semibold tracking-tight">El ERP de una planta, proceso por proceso</h2>
      <a href={ruta('/erp')} class="text-sm font-medium text-[var(--acento)]">Ver el ERP completo →</a>
    </div>
    <p class="mt-3 max-w-3xl text-[var(--texto-suave)]">
      En BBA Pack lidero el ERP Odoo desde 2023. En 2026 el partner externo salió y hubo que desinstalar todo lo
      personalizado: lo reconstruí, lo migré de Odoo {cifrasErp.versionDesde} a {cifrasErp.versionHasta} y hoy
      conecta los turnos, el huellero, la planilla y SUNAT.
    </p>
    <div class="mt-6">
      <CifrasErp />
    </div>
    <ul class="mt-4 grid gap-4 sm:grid-cols-2">
      {
        procesos.map(({ caso, modulos }, i) => (
          <TarjetaCaso caso={caso} antetitulo={`Proceso ${i + 1} · ${modulos} ${modulos === 1 ? 'módulo' : 'módulos'}`} />
        ))
      }
    </ul>
  </section>

  <section class="mx-auto max-w-5xl px-4 pb-14 sm:px-6" aria-labelledby="datos">
    <div class="flex flex-wrap items-baseline justify-between gap-2">
      <h2 id="datos" class="text-2xl font-semibold tracking-tight">Datos para decidir</h2>
      <a href={ruta('/casos')} class="text-sm font-medium text-[var(--acento)]">Todos los casos →</a>
    </div>
    <ul class="mt-6 grid gap-4 sm:grid-cols-2">
      {casosDatos.map((caso) => <TarjetaCaso caso={caso} />)}
      <li
        class="group relative flex flex-col rounded-[var(--radius-card)] border border-[var(--borde)] bg-[var(--superficie)] p-5 transition-colors hover:border-[var(--acento)]"
      >
        <p class="font-mono text-eyebrow uppercase text-[var(--texto-suave)]">Proyecto propio · Data Studio</p>
        <h3 class="mt-2 text-lg font-semibold leading-snug">
          <a href={ruta('/dashboard')} class="no-underline after:absolute after:inset-0 group-hover:text-[var(--acento)]">
            Dashboard de matrícula de la U. de Lima
          </a>
        </h3>
        <p class="mt-2 flex-1 text-[var(--texto-suave)]">
          La matrícula creció {resumenMatricula.crecimiento} % en cinco años. Cuatro páginas con matrícula, postulantes e
          ingresantes por carrera.
        </p>
        <p class="mt-4 text-sm font-medium text-[var(--acento)]">Ver dashboard →</p>
      </li>
    </ul>
  </section>

  <section class="mx-auto max-w-5xl px-4 pb-20 sm:px-6" aria-labelledby="pilares">
    <h2 id="pilares" class="text-2xl font-semibold tracking-tight">Lo que aporto</h2>
    <ul class="mt-6 grid gap-4 sm:grid-cols-2">
      {
        pilares.map((pilar) => (
          <li class="rounded-[var(--radius-card)] border border-[var(--borde)] bg-[var(--superficie)] p-5">
            <h3 class="font-semibold">{pilar.titulo}</h3>
            <p class="mt-2 text-[var(--texto-suave)]">{pilar.frase}</p>
            <ul class="mt-4 flex flex-wrap gap-2 text-sm">
              {pilar.evidencia.map((e) => (
                <li class="rounded bg-[var(--acento-suave)] px-2 py-1 text-[var(--acento)]">{e}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
