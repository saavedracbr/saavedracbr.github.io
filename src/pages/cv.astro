---
/**
 * CV de una página, en HTML, pensado para imprimirse a PDF.
 *
 * `npm run cv` construye el sitio y `scripts/cv-pdf.mjs` imprime esta página
 * con Edge en modo headless a `public/cv-bruno-saavedra.pdf`. Reglas:
 * - Una sola columna y encabezados estándar, para que un ATS lo lea en orden.
 * - Todo es texto real (nada de texto dentro de imágenes) y los enlaces quedan
 *   clicables en el PDF.
 * - Una página A4. En pantalla, la hoja se marca en rojo si el contenido se pasa.
 */
import { Font } from 'astro:assets';
import Analitica from '../components/Analitica.astro';
import Compartir from '../components/Compartir.astro';
import QRCode from 'qrcode';
import {
  persona,
  oferta,
  experiencia,
  educacion,
  proyectos,
  certificados,
  habilidades,
  idiomas,
  actividades,
} from '../data/perfil.ts';
import { GA4_ID, urlConUtm, type Canal } from '../data/medicion.ts';
import { ruta, urlAbsoluta, urlVisible } from '../utils/rutas.ts';

// El QR lleva al portafolio con la UTM de su canal, para saber cuántas visitas
// trae el CV: el PDF del sitio, o el impreso de la feria (`npm run cv:feria`
// construye con CV_CANAL=feria). Corrección L: el papel limpio no la necesita
// más alta, y así los módulos salen más gruesos y se leen mejor impresos.
const canal: Canal = process.env.CV_CANAL === 'feria' ? 'feria' : 'cv';
const urlQr = urlConUtm(persona.web, canal);
const qrSvg = await QRCode.toString(urlQr, {
  type: 'svg',
  margin: 0,
  errorCorrectionLevel: 'L',
  color: { dark: '#151a21', light: '#0000' },
});

const certificadosCv = certificados.filter((c) => c.enCv);
const proyectosCv = proyectos.filter((p) => p.enCv);
// Un proyecto que enlaza a un certificado de la lista no repite el enlace: ya está en Certificaciones.
const urlsCertificados = new Set(certificadosCv.map((c) => c.url));
const anio = (fecha: string | null) => fecha?.split(' ').at(-1);
const electivosCv = educacion.electivos.map((e) => (e.detalle ? `${e.nombre} (${e.detalle})` : e.nombre));
// Un solo renglón dentro de Educación: un encabezado propio no cabría en la hoja.
const actividadesCv = actividades.filter((a) => a.enCv).map((a) => a.nombreCv ?? a.nombre);
const estadoEstudios = [
  educacion.ciclo ? `${educacion.ciclo} ciclo` : 'Pregrado en curso',
  educacion.egresoEstimado && `egreso estimado: ${educacion.egresoEstimado}`,
]
  .filter(Boolean)
  .join(' · ');

const contacto = [
  { texto: persona.ubicacion },
  { texto: persona.email, href: `mailto:${persona.email}` },
  ...(persona.telefono ? [{ texto: persona.telefono, href: `tel:${persona.telefono.replace(/\s/g, '')}` }] : []),
  { texto: urlVisible(persona.web), href: persona.web },
  { texto: urlVisible(persona.linkedin), href: persona.linkedin },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>CV – {persona.nombre}</title>
    <meta name="description" content={`CV de ${persona.nombre}. ${oferta.frase}`} />
    <link rel="canonical" href={urlAbsoluta('/cv/', Astro.site)} />
    <Compartir
      titulo={`CV – ${persona.nombre}`}
      descripcion={`CV de ${persona.nombre}. ${oferta.frase}`}
      url={urlAbsoluta('/cv/', Astro.site)}
      imagen="cv"
    />
    <meta name="author" content={persona.nombre} />
    <Font cssVariable="--font-body" preload />
    <Analitica />
  </head>
  <body>
    <nav class="barra" aria-label="Acciones del CV">
      <a href={ruta('/')}>← Volver al portafolio</a>
      <a href={ruta('/cv-bruno-saavedra.pdf')} class="boton" download>Descargar PDF</a>
    </nav>

    <article class="hoja" id="hoja">
      <header class="cabecera">
        <div>
          <h1>{persona.nombre}</h1>
          <p class="subtitulo">{persona.titulo} · {persona.universidad}</p>
          <p class="contacto">
            {
              contacto.map((c, i) => (
                <>
                  {i > 0 && <span class="sep" aria-hidden="true"> · </span>}
                  {c.href ? <a href={c.href}>{c.texto}</a> : <span>{c.texto}</span>}
                </>
              ))
            }
          </p>
        </div>
        <a class="qr" href={urlQr} aria-label="Portafolio con casos y demos">
          <span set:html={qrSvg} />
          <span class="qr-texto">Casos y demos</span>
        </a>
      </header>

      <section>
        <h2>Perfil</h2>
        <p>{oferta.resumenCv}</p>
      </section>

      <section>
        <h2>Educación</h2>
        <div class="fila">
          <p><strong>{educacion.institucion}</strong> — {educacion.carrera}</p>
          <p class="fecha">{estadoEstudios}</p>
        </div>
        <p class="detalle">Cursos electivos: {electivosCv.join(' · ')}.</p>
        {actividadesCv.length > 0 && <p class="detalle">Actividades: {actividadesCv.join(' · ')}.</p>}
      </section>

      <section>
        <h2>Experiencia</h2>
        {
          experiencia.map((emp) => (
            <div class="empresa">
              <div class="fila">
                <p>
                  <strong>{emp.empresa}</strong> <span class="suave">— {emp.descripcion}</span>
                </p>
                <p class="fecha">{emp.ubicacion}</p>
              </div>
              {emp.roles.map((rol) => (
                <div class="rol">
                  <div class="fila">
                    <div>
                      <h3>
                        {rol.cargo} <span class="suave">· {rol.modalidad}</span>
                      </h3>
                      {rol.enlace && (
                        <>
                          {' '}
                          <span class="suave">·</span>{' '}
                          <a class="enlace-rol" href={rol.enlace.url}>
                            {rol.enlace.etiqueta}
                          </a>
                        </>
                      )}
                    </div>
                    <p class="fecha">
                      {rol.desde} – {rol.hasta ?? 'actualidad'}
                    </p>
                  </div>
                  <ul>
                    {rol.logros.map((logro) => (
                      <li>{logro}</li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          ))
        }
      </section>

      <section>
        <h2>Proyectos</h2>
        <ul class="proyectos">
          {
            proyectosCv.map((p) => (
              <li>
                <strong>{p.nombreCv ?? p.nombre}</strong>
                <span class="suave">
                  {' '}
                  · {p.contexto} · {p.herramientas.join(', ')}
                </span>
                {p.enlace && !urlsCertificados.has(p.enlace.url) && (
                  <>
                    {' '}
                    · <a href={p.enlace.url}>{p.enlace.etiqueta}</a>
                  </>
                )}
                <br />
                {p.resumenCv ?? p.resumen}
              </li>
            ))
          }
        </ul>
      </section>

      <section>
        <h2>Certificaciones</h2>
        <p class="certificados">
          {
            certificadosCv.map((c, i) => (
              <>
                {i > 0 && <span class="sep" aria-hidden="true"> · </span>}
                {c.url ? <a href={c.url}>{c.nombre}</a> : c.nombre}
                <span class="suave">
                  {' '}
                  ({[c.emisorCorto, anio(c.fecha)].filter(Boolean).join(', ')})
                </span>
              </>
            ))
          }
        </p>
      </section>

      <section>
        <h2>Habilidades e idiomas</h2>
        <ul class="habilidades">
          {
            habilidades.map((h) => (
              <li>
                <strong>{h.grupo}:</strong> {h.items.join(' · ')}
              </li>
            ))
          }
          <li>
            <strong>Idiomas:</strong>{' '}
            {idiomas.map((i) => `${i.idioma} (${i.nivel})`).join(' · ')}
          </li>
        </ul>
      </section>
    </article>

    {GA4_ID && <p class="aviso">Este sitio mide visitas de forma agregada con Google Analytics.</p>}

    <script>
      // Aviso solo en pantalla: si el contenido no cabe en una hoja A4, se marca.
      const hoja = document.getElementById('hoja');
      const revisar = () => {
        if (!hoja) return;
        hoja.classList.toggle('desborda', hoja.scrollHeight > hoja.clientHeight + 1);
      };
      document.fonts.ready.then(revisar);
      window.addEventListener('resize', revisar);
    </script>

    <style is:global>
      @page {
        size: A4;
        margin: 0;
      }

      :root {
        --tinta: #151a21;
        --suave: #4a5260;
        --acento: #145c8c;
        --linea: #d9dde4;
        color-scheme: light;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
      }

      body {
        background: #e7eaef;
        color: var(--tinta);
        font-family: var(--font-body), 'Segoe UI', Arial, sans-serif;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }

      .barra {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        max-width: 210mm;
        margin: 0 auto;
        padding: 16px;
        font-size: 14px;
      }

      .barra a {
        color: var(--acento);
      }

      .barra .boton {
        background: var(--acento);
        color: #fff;
        padding: 8px 14px;
        border-radius: 6px;
        text-decoration: none;
        font-weight: 600;
      }

      .hoja {
        width: 210mm;
        height: 297mm;
        margin: 0 auto 32px;
        padding: 10mm 14mm;
        background: #fff;
        box-shadow: 0 2px 14px rgb(0 0 0 / 0.12);
        overflow: hidden;
        font-size: 9.1pt;
        line-height: 1.32;
      }

      .hoja.desborda {
        outline: 3px solid #d12f2f;
      }

      .hoja a {
        color: inherit;
        text-decoration: none;
      }

      .hoja p,
      .hoja ul,
      .hoja h1,
      .hoja h2,
      .hoja h3 {
        margin: 0;
      }

      .cabecera {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 8mm;
        padding-bottom: 3.2mm;
        border-bottom: 1.6pt solid var(--acento);
      }

      .cabecera h1 {
        font-size: 21pt;
        line-height: 1.1;
        font-weight: 700;
        letter-spacing: -0.015em;
      }

      .subtitulo {
        margin-top: 1mm !important;
        font-size: 11pt;
        font-weight: 500;
        color: var(--acento);
      }

      .contacto {
        margin-top: 1.8mm !important;
        color: var(--suave);
        font-size: 8.8pt;
      }

      .contacto a {
        color: var(--tinta) !important;
      }

      .sep {
        color: #8a93a1;
      }

      .qr {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1mm;
        flex: none;
      }

      .qr svg {
        width: 19mm;
        height: 19mm;
        display: block;
      }

      .qr-texto {
        font-size: 6.8pt;
        color: var(--suave);
        letter-spacing: 0.02em;
      }

      section {
        margin-top: 2.8mm;
      }

      h2 {
        font-size: 9pt;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--acento);
        padding-bottom: 0.8mm;
        margin-bottom: 1.4mm !important;
        border-bottom: 0.6pt solid var(--linea);
      }

      /* En línea: el enlace del rol va en la misma fila que el cargo. */
      h3 {
        display: inline;
        font-size: 9.4pt;
        font-weight: 600;
      }

      .fila {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 4mm;
      }

      .fecha {
        flex: none;
        color: var(--suave);
        font-size: 8.6pt;
        white-space: nowrap;
      }

      .suave {
        color: var(--suave);
        font-weight: 400;
      }

      .detalle {
        margin-top: 0.6mm !important;
        color: var(--suave);
      }

      .rol {
        margin-top: 1.8mm;
      }

      .rol ul {
        margin-top: 0.8mm;
        padding-left: 4.2mm;
      }

      .rol li + li {
        margin-top: 0.6mm;
      }

      .rol li::marker {
        color: var(--acento);
      }

      .proyectos,
      .habilidades {
        list-style: none;
        padding: 0;
      }

      .proyectos li + li {
        margin-top: 1.4mm;
      }

      .enlace-rol,
      .proyectos a,
      .certificados a {
        color: var(--acento) !important;
      }

      .certificados .suave {
        white-space: nowrap;
      }

      .habilidades li + li {
        margin-top: 0.6mm;
      }

      .aviso {
        max-width: 210mm;
        margin: 0 auto;
        padding: 0 16px 24px;
        color: var(--suave);
        font-size: 12px;
        text-align: center;
      }

      @media print {
        body {
          background: #fff;
        }

        .barra,
        .aviso {
          display: none;
        }

        .hoja {
          margin: 0;
          box-shadow: none;
          outline: none !important;
        }
      }

      @media screen and (max-width: 820px) {
        .hoja {
          width: auto;
          height: auto;
          margin: 0 16px 24px;
          padding: 20px;
          overflow: visible;
        }

        /* En el celular ya estás en el sitio: el QR sobra. */
        .qr {
          display: none;
        }

        .fila {
          flex-direction: column;
          gap: 0;
        }
      }
    </style>
  </body>
</html>
