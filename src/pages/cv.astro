---
/**
 * CV de una página, en HTML, pensado para imprimirse a PDF.
 *
 * `npm run cv` construye el sitio y `scripts/cv-pdf.mjs` imprime esta página
 * con Edge en modo headless a `public/cv-bruno-saavedra.pdf`. Reglas:
 * - Una sola columna y encabezados estándar, para que un ATS lo lea en orden.
 * - Todo es texto real (nada de texto dentro de imágenes) y los enlaces quedan
 *   clicables en el PDF.
 * - Una página A4. En pantalla, la hoja se marca en rojo si el contenido se pasa.
 */
import { Font } from 'astro:assets';
import QRCode from 'qrcode';
import {
  persona,
  oferta,
  experiencia,
  educacion,
  proyectos,
  certificados,
  habilidades,
  idiomas,
} from '../data/perfil.ts';
import { ruta, urlVisible } from '../utils/rutas.ts';

// El QR lleva al portafolio con UTM propia, para saber cuántas visitas trae el CV.
const urlQr = new URL('/?utm_source=cv&utm_medium=qr', persona.web).href;
const qrSvg = await QRCode.toString(urlQr, {
  type: 'svg',
  margin: 0,
  errorCorrectionLevel: 'M',
  color: { dark: '#151a21', light: '#0000' },
});

const certificadosCv = certificados.filter((c) => c.enCv);
const estadoEstudios = [
  educacion.ciclo ? `${educacion.ciclo} ciclo` : 'Pregrado en curso',
  educacion.egresoEstimado && `egreso estimado: ${educacion.egresoEstimado}`,
]
  .filter(Boolean)
  .join(' · ');

const contacto = [
  { texto: persona.ubicacion },
  { texto: persona.email, href: `mailto:${persona.email}` },
  ...(persona.telefono ? [{ texto: persona.telefono, href: `tel:${persona.telefono.replace(/\s/g, '')}` }] : []),
  { texto: urlVisible(persona.web), href: persona.web },
  { texto: urlVisible(persona.linkedin), href: persona.linkedin },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>CV – {persona.nombre}</title>
    <meta name="description" content={`CV de ${persona.nombre}. ${oferta.frase}`} />
    <meta name="author" content={persona.nombre} />
    <Font cssVariable="--font-body" preload />
  </head>
  <body>
    <nav class="barra" aria-label="Acciones del CV">
      <a href={ruta('/')}>← Volver al portafolio</a>
      <a href={ruta('/cv-bruno-saavedra.pdf')} class="boton" download>Descargar PDF</a>
    </nav>

    <article class="hoja" id="hoja">
      <header class="cabecera">
        <div>
          <h1>{persona.nombre}</h1>
          <p class="subtitulo">{persona.titulo} · {persona.universidad}</p>
          <p class="contacto">
            {
              contacto.map((c, i) => (
                <>
                  {i > 0 && <span class="sep" aria-hidden="true"> · </span>}
                  {c.href ? <a href={c.href}>{c.texto}</a> : <span>{c.texto}</span>}
                </>
              ))
            }
          </p>
        </div>
        <a class="qr" href={urlQr} aria-label="Portafolio con casos y demos">
          <span set:html={qrSvg} />
          <span class="qr-texto">Casos y demos</span>
        </a>
      </header>

      <section>
        <h2>Perfil</h2>
        <p>{oferta.resumenCv}</p>
      </section>

      <section>
        <h2>Educación</h2>
        <div class="fila">
          <p><strong>{educacion.institucion}</strong> — {educacion.carrera}</p>
          <p class="fecha">{estadoEstudios}</p>
        </div>
        <p class="detalle">Cursos relevantes: {educacion.cursos.join(' · ')}.</p>
      </section>

      <section>
        <h2>Experiencia</h2>
        {
          experiencia.map((emp) => (
            <div class="empresa">
              <div class="fila">
                <p>
                  <strong>{emp.empresa}</strong> <span class="suave">— {emp.descripcion}</span>
                </p>
                <p class="fecha">{emp.ubicacion}</p>
              </div>
              {emp.roles.map((rol) => (
                <div class="rol">
                  <div class="fila">
                    <h3>
                      {rol.cargo} <span class="suave">· {rol.modalidad}</span>
                    </h3>
                    <p class="fecha">
                      {rol.desde} – {rol.hasta ?? 'actualidad'}
                    </p>
                  </div>
                  <ul>
                    {rol.logros.map((logro) => (
                      <li>{logro}</li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          ))
        }
      </section>

      <section>
        <h2>Proyectos</h2>
        <ul class="proyectos">
          {
            proyectos.map((p) => (
              <li>
                <strong>{p.nombre}</strong>
                <span class="suave">
                  {' '}
                  · {p.contexto} · {p.herramientas.join(', ')}
                </span>
                {p.enlace && (
                  <>
                    {' '}
                    · <a href={p.enlace.url}>{p.enlace.etiqueta}</a>
                  </>
                )}
                <br />
                {p.resumen}
              </li>
            ))
          }
        </ul>
      </section>

      <section>
        <h2>Certificaciones</h2>
        <ul class="certificados">
          {
            certificadosCv.map((c) => (
              <li>
                {c.url ? <a href={c.url}>{c.nombre}</a> : c.nombre}
                <span class="suave">
                  {' '}
                  — {c.emisorCorto}, {c.fecha}
                </span>
              </li>
            ))
          }
        </ul>
      </section>

      <section>
        <h2>Habilidades e idiomas</h2>
        <ul class="habilidades">
          {
            habilidades.map((h) => (
              <li>
                <strong>{h.grupo}:</strong> {h.items.join(' · ')}
              </li>
            ))
          }
          <li>
            <strong>Idiomas:</strong>{' '}
            {idiomas.map((i) => `${i.idioma} (${i.nivel.toLowerCase()})`).join(' · ')}
          </li>
        </ul>
      </section>
    </article>

    <script>
      // Aviso solo en pantalla: si el contenido no cabe en una hoja A4, se marca.
      const hoja = document.getElementById('hoja');
      const revisar = () => {
        if (!hoja) return;
        hoja.classList.toggle('desborda', hoja.scrollHeight > hoja.clientHeight + 1);
      };
      document.fonts.ready.then(revisar);
      window.addEventListener('resize', revisar);
    </script>

    <style is:global>
      @page {
        size: A4;
        margin: 0;
      }

      :root {
        --tinta: #151a21;
        --suave: #4a5260;
        --acento: #145c8c;
        --linea: #d9dde4;
        color-scheme: light;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
      }

      body {
        background: #e7eaef;
        color: var(--tinta);
        font-family: var(--font-body), 'Segoe UI', Arial, sans-serif;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }

      .barra {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        max-width: 210mm;
        margin: 0 auto;
        padding: 16px;
        font-size: 14px;
      }

      .barra a {
        color: var(--acento);
      }

      .barra .boton {
        background: var(--acento);
        color: #fff;
        padding: 8px 14px;
        border-radius: 6px;
        text-decoration: none;
        font-weight: 600;
      }

      .hoja {
        width: 210mm;
        height: 297mm;
        margin: 0 auto 32px;
        padding: 12mm 14mm 11mm;
        background: #fff;
        box-shadow: 0 2px 14px rgb(0 0 0 / 0.12);
        overflow: hidden;
        font-size: 9.1pt;
        line-height: 1.36;
      }

      .hoja.desborda {
        outline: 3px solid #d12f2f;
      }

      .hoja a {
        color: inherit;
        text-decoration: none;
      }

      .hoja p,
      .hoja ul,
      .hoja h1,
      .hoja h2,
      .hoja h3 {
        margin: 0;
      }

      .cabecera {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 8mm;
        padding-bottom: 3.2mm;
        border-bottom: 1.6pt solid var(--acento);
      }

      .cabecera h1 {
        font-size: 21pt;
        line-height: 1.1;
        font-weight: 700;
        letter-spacing: -0.015em;
      }

      .subtitulo {
        margin-top: 1mm !important;
        font-size: 11pt;
        font-weight: 500;
        color: var(--acento);
      }

      .contacto {
        margin-top: 1.8mm !important;
        color: var(--suave);
        font-size: 8.8pt;
      }

      .contacto a {
        color: var(--tinta) !important;
      }

      .sep {
        color: #8a93a1;
      }

      .qr {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1mm;
        flex: none;
      }

      .qr svg {
        width: 19mm;
        height: 19mm;
        display: block;
      }

      .qr-texto {
        font-size: 6.8pt;
        color: var(--suave);
        letter-spacing: 0.02em;
      }

      section {
        margin-top: 3.6mm;
      }

      h2 {
        font-size: 9pt;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--acento);
        padding-bottom: 0.8mm;
        margin-bottom: 1.6mm !important;
        border-bottom: 0.6pt solid var(--linea);
      }

      h3 {
        font-size: 9.4pt;
        font-weight: 600;
      }

      .fila {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 4mm;
      }

      .fecha {
        flex: none;
        color: var(--suave);
        font-size: 8.6pt;
        white-space: nowrap;
      }

      .suave {
        color: var(--suave);
        font-weight: 400;
      }

      .detalle {
        margin-top: 0.6mm !important;
        color: var(--suave);
      }

      .rol {
        margin-top: 1.8mm;
      }

      .rol ul {
        margin-top: 0.8mm;
        padding-left: 4.2mm;
      }

      .rol li + li {
        margin-top: 0.6mm;
      }

      .rol li::marker {
        color: var(--acento);
      }

      .proyectos,
      .certificados,
      .habilidades {
        list-style: none;
        padding: 0;
      }

      .proyectos li + li {
        margin-top: 1.4mm;
      }

      .proyectos a,
      .certificados a {
        color: var(--acento) !important;
      }

      /* Dos columnas al ancho de su contenido: los nombres largos no parten la fecha. */
      .certificados {
        display: grid;
        grid-template-columns: auto auto;
        justify-content: space-between;
        column-gap: 6mm;
        row-gap: 0.6mm;
      }

      .certificados .suave {
        white-space: nowrap;
      }

      .habilidades li + li {
        margin-top: 0.6mm;
      }

      @media print {
        body {
          background: #fff;
        }

        .barra {
          display: none;
        }

        .hoja {
          margin: 0;
          box-shadow: none;
          outline: none !important;
        }
      }

      @media screen and (max-width: 820px) {
        .hoja {
          width: auto;
          height: auto;
          margin: 0 16px 24px;
          padding: 20px;
          overflow: visible;
        }

        /* En el celular ya estás en el sitio: el QR sobra. */
        .qr {
          display: none;
        }

        .fila {
          flex-direction: column;
          gap: 0;
        }

        .certificados {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </body>
</html>
